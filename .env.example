# Copy to .env.local for local development, and set the same names in Vercel > Settings > Environment Variables.
# Never commit real values.

# Required for the AI "Explain this" feature. The key stays on the server.
ANTHROPIC_API_KEY=
# Required: a passcode you choose. The app asks for it once per browser; it stops strangers from spending your API credit.
APP_ACCESS_CODE=

# Optional
# EXPLAIN_MODEL=claude-opus-5-5        # e.g. claude-sonnet-5-5 for lower cost
# EXPLAIN_EFFORT=high                  # low | medium | high | xhigh | max
# EXPLAIN_FALLBACKS=off                # turn off the server-side refusal-fallback parameter
# EXPLAIN_RATE_PER_HOUR=60             # per visitor, best effort
